# Copia este archivo a .env y ajusta los valores antes de levantar el entorno.
#   cp .env.example .env
# Las variables tienen valores por defecto en docker-compose.yml, así que el
# stack funciona sin .env; este archivo documenta lo que puedes personalizar.

# --- Base de datos MySQL ---
MYSQL_ROOT_PASSWORD=monetra_root
MYSQL_DATABASE=monetra_db
DB_PORT=3306

# --- API .NET ---
# Clave para firmar los tokens JWT. CÁMBIALA en un entorno real (mínimo 32 bytes).
JWT_SECRET=MonetraSuperSecureKeyForProductionChangeMe256BitsMinimumLength!
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5127

# --- Sitio web ---
WEB_PORT=8080
